# Core runtime
NODE_ENV=development
PORT=3001
WEB_ORIGIN=http://localhost:3000
CORS_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://movex:movex@localhost:5432/movex?schema=public
REDIS_URL=redis://localhost:6379

# Sessions, CSRF, encryption, and staff security
SESSION_COOKIE_NAME=__Host-movex_session
CSRF_COOKIE_NAME=movex_csrf
SESSION_TTL_SECONDS=2592000
AUTH_HASH_SECRET=replace-with-a-long-random-secret
CONFIG_SECRET_KEY=replace-with-32-byte-config-secret
MFA_SECRET_KEY=replace-with-32-byte-mfa-secret
ADMIN_BOOTSTRAP_TOKEN=replace-with-one-time-setup-token
STAFF_MFA_REQUIRED=true

# OTP and request throttling
OTP_TTL_SECONDS=300
OTP_REQUEST_PHONE_LIMIT=3
OTP_REQUEST_IP_LIMIT=20
OTP_VERIFY_PHONE_LIMIT=20
OTP_VERIFY_IP_LIMIT=60
OTP_HASH_SALT=replace-with-a-long-random-ride-otp-salt
ORDER_OTP_HASH_SALT=replace-with-a-long-random-order-otp-salt

# SMS: mock for local development, http for the production gateway
SMS_PROVIDER=mock
SMS_GATEWAY_URL=
SMS_GATEWAY_API_KEY=
SMS_GATEWAY_SENDER=
SMS_GATEWAY_TEMPID=

# Maps: open-source uses Photon, Nominatim, OSRM, and OpenStreetMap data
MAPS_PROVIDER=open-source
GOOGLE_MAPS_API_KEY=
MAPS_GEOCODE_CACHE_TTL_MS=300000
MAPS_ROUTE_CACHE_TTL_MS=60000

# Payments
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Notifications
EMAIL_PROVIDER=mock
RESEND_API_KEY=
NOTIFICATION_EMAIL_FROM="MoveX <notifications@example.com>"

# Search
SEARCH_PROVIDER=postgres
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_API_KEY=
MEILISEARCH_STORE_INDEX=movex_stores

# Observability and optional realtime transport
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.1
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
MQTT_ENABLED=false
MQTT_BROKER_ACL_CONFIGURED=false
