# Core runtime
NODE_ENV=development
DATABASE_URL=postgresql://movex:movex@localhost:5432/movex?schema=public
REDIS_URL=redis://localhost:6379
WEB_ORIGIN=http://localhost:3000
AUTH_HASH_SECRET=replace-with-the-same-long-secret-as-the-api

# Notification delivery
EMAIL_PROVIDER=mock
RESEND_API_KEY=
NOTIFICATION_EMAIL_FROM="MoveX <notifications@example.com>"

# Search indexing
SEARCH_PROVIDER=postgres
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_API_KEY=
MEILISEARCH_STORE_INDEX=movex_stores

# Outbox processing
OUTBOX_POLL_INTERVAL_MS=2000
OUTBOX_BATCH_SIZE=25
OUTBOX_MAX_ATTEMPTS=10
OUTBOX_WORKER_LOCK_TTL_MS=60000
OUTBOX_HANDLER_IDEMPOTENCY_TTL_MS=604800000

# Observability
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.1
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces